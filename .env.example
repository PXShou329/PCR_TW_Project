# Copy to .env and replace every non-secret placeholder before Compose startup.
# Use distinct URL-safe values (letters, digits, '-' and '_') of 16+ characters.
POSTGRES_PASSWORD=replace-with-owner-local-dev-password
POSTGRES_USER=pcr_owner
POSTGRES_DB=pcr_tw
PCR_API_DB_PASSWORD=replace-with-api-readonly-password
PCR_IMPORTER_DB_PASSWORD=replace-with-importer-dml-password
PCR_SCHEDULER_DB_PASSWORD=replace-with-scheduler-control-password

API_PORT=8000
WEB_PORT=3000
SCHEDULER_HEALTH_PORT=8081

# B0 hard safety defaults. The application rejects unsafe overrides.
SCHEDULER_ENABLED=false
SHADOW_MODE=true
AUTO_PUBLISH=false
SCHEDULER_POLL_SECONDS=60
SCHEDULER_LEASE_TTL_SECONDS=180

# Must resolve inside the repository; contents are ignored by Git.
BACKUP_DIR=../.runtime/backups
